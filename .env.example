# ===== Database (PostgreSQL) =====
# Vercel Postgres / Neon / Supabase connection string.
# Use the POOLED connection string for serverless.
DATABASE_URL="postgresql://user:password@host:5432/katz?sslmode=require"

# ===== Auth.js (NextAuth v5) =====
# Generate with:  npx auth secret
AUTH_SECRET="replace-me-with-a-long-random-string"

# Required on Vercel / any non-localhost host
AUTH_TRUST_HOST=true

# ===== Google OAuth =====
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# ===== App config =====
# Restrict sign-in to a single email domain (internal use).
# Leave empty to allow any Google account.
ALLOWED_EMAIL_DOMAIN="42creative.co.il"

# The super-admin email — always granted ADMIN role.
SUPER_ADMIN_EMAIL="or@42creative.co.il"

# --- Redis (Upstash) -------------------------------------------------------
# Keeps redirects off Postgres and buffers clicks so Neon can stay suspended.
# Provision via Vercel > Storage > Upstash Redis, which injects KV_REST_API_*
# automatically. A standalone Upstash database sets UPSTASH_REDIS_REST_* — both
# names are accepted. If neither is set the app falls back to querying Postgres
# on every redirect, exactly as it did before.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for the daily click-flush cron. Vercel sends it as
# `Authorization: Bearer $CRON_SECRET`. Required in production.
CRON_SECRET=

# ===== API למערכות אחרות של 42 =====
# סוד משותף ל-POST /api/links. הקורא שולח אותו בכותרת:
#   Authorization: Bearer $KATZ_API_TOKEN
# בלי המשתנה הזה ה-endpoint מחזיר 503 ולא יוצר כלום.
# ייצור:  openssl rand -hex 32
KATZ_API_TOKEN=

# החשבון שמחזיק לינקים שנוצרו דרך ה-API. לא חייב להיות מוגדר —
# ברירת המחדל היא api@katz.service. חשוב: לא כתובת מייל אמיתית ולא
# חשבון גוגל, כדי שאי אפשר יהיה להתחבר כמוהו ולרשת את הלינקים.
KATZ_API_USER_EMAIL="api@katz.service"

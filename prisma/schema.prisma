generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

/// What a colleague may do with a link that was shared with them.
enum LinkRole {
  /// Read-only: may see the statistics and export them.
  VIEWER
  /// May also change the link's details and disable it. Deleting and
  /// re-sharing stay with the owner (and admins).
  EDITOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())

  accounts   Account[]
  sessions   Session[]
  links      Link[]
  linkShares LinkShare[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Link {
  id        String    @id @default(cuid())
  slug      String    @unique
  url       String    @db.Text
  title     String?
  ownerId   String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  disabled  Boolean   @default(false)
  /// The client this link belongs to, as Tiki's `Client.id` — the cuid that is
  /// the shared identifier across 42's systems. Opaque here: Katz has no client
  /// table of its own and never resolves it to a name.
  clientId  String?

  owner  User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clicks Click[]
  shares LinkShare[]

  @@index([ownerId])
  @@index([clientId])
}

model Click {
  id        String   @id @default(cuid())
  linkId    String
  createdAt DateTime @default(now())
  referer   String?  @db.Text
  source    String?
  country   String?
  city      String?
  device    String?

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
}

/// Grants one user access to a link they do not own.
model LinkShare {
  id         String   @id @default(cuid())
  linkId     String
  userId     String
  role       LinkRole @default(VIEWER)
  createdAt  DateTime @default(now())
  /// Who granted the access. Kept for auditing; not a relation, to avoid a
  /// second User relation on this table.
  sharedById String?

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([linkId, userId])
  @@index([userId])
}
